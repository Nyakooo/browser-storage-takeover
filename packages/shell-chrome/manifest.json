{
  "manifest_version": 3,
  "name": "Takeover browser storage",
  "version": "1.1.0",
  "description": "Inspect and edit Local Storage, Session Storage, Cookies, and IndexedDB for the site in your current tab.",
  "author": "Gj",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "components/index.iife.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "24": "icons/24.png",
      "32": "icons/32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "components/style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "open_modal": {
      "suggested_key": {
        "default": "Alt+W",
        "windows": "Alt+W",
        "mac": "Alt+W",
        "linux": "Alt+W"
      },
      "description": "Open modal"
    }
  },
  "permissions": [
    "cookies",
    "webNavigation"
  ],
  "minimum_chrome_version": "132"
}
