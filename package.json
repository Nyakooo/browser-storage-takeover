{
  "name": "browser-storage-takeover",
  "version": "1.1.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "Inspect and edit Local Storage, Session Storage, Cookies, and IndexedDB for the site in your current tab.",
  "scripts": {
    "dev": "pnpm -C ./packages/shell-components dev",
    "build": "run-s build:all pkg",
    "build:all": "pnpm -F \"./packages/**\" build",
    "pkg": "cp -r ./packages/shell-components/dist ./packages/shell-chrome/build/components",
    "zip": "node ./extension-zips.js",
    "preinstall": "npx only-allow pnpm",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "archiver": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "playwright": "1.62.1",
    "progress": "^2.0.3",
    "readdir-glob": "^1.1.2",
    "rimraf": "^6.1.3",
    "semver": "^7.3.7",
    "typescript": "^6.0.3"
  }
}
